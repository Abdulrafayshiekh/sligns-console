APP_NAME="Aligna Console"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://aligna-console.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aligna_console
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="console@aligna.ai"
MAIL_FROM_NAME="${APP_NAME}"

DEPLOYER_EMAIL=admin@aligna.ai
DEPLOYER_MASTER_KEY=aligna-master-key
